From 11d4cc20b0f6850a77269a666492bf78edc88062 Mon Sep 17 00:00:00 2001
From: Michael Bestas <mkbestas@gmail.com>
Date: Thu, 17 Oct 2024 06:10:07 +0300
Subject: [PATCH 3/3] gen_build_prop: Set ro.build.fingerprint

Change-Id: I0e40b6f8154f8bc9a7b8450ecb4af4c44ab3d46d
---
 scripts/gen_build_prop.py | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/scripts/gen_build_prop.py b/scripts/gen_build_prop.py
index 57af957500..5c70d03ab9 100644
--- a/scripts/gen_build_prop.py
+++ b/scripts/gen_build_prop.py
@@ -201,6 +201,8 @@ def generate_build_info(args):
   config = args.config
   build_flags = config["BuildFlags"]
 
+  print(f"ro.build.fingerprint?={config['BuildFingerprint']}")
+
   # The ro.build.id will be set dynamically by init, by appending the unique vbmeta digest.
   if config["BoardUseVbmetaDigestInFingerprint"]:
     print(f"ro.build.legacy.id={config['BuildId']}")
