From e4a5042d2e14019aa78f62d7e9cd073b1338600f Mon Sep 17 00:00:00 2001
From: Yumi Yukimura <me.cafebabe@gmail.com>
Date: Fri, 14 Mar 2025 03:42:19 +0800
Subject: [PATCH 2/2] kernel: Use UTC timezone on kernel build date

Change-Id: I764bc2da45766de70e8be44dd0161338c6b9e671
---
 config/BoardConfigKernel.mk | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/config/BoardConfigKernel.mk b/config/BoardConfigKernel.mk
index ca1a52ad..254eba82 100644
--- a/config/BoardConfigKernel.mk
+++ b/config/BoardConfigKernel.mk
@@ -141,7 +141,7 @@ endif
 
 # Clear these first to prevent accidental poisoning from env
 KERNEL_BAZEL_FLAGS := $(TARGET_KERNEL_BAZEL_FLAGS)
-KERNEL_MAKE_FLAGS :=
+KERNEL_MAKE_FLAGS := KBUILD_BUILD_TIMESTAMP="$(shell LC_ALL=C TZ=UTC date '+%a %b %e 00:00:00 %Z %Y')"
 
 ifeq ($(TARGET_KERNEL_UNSAFE_DDK_HEADERS),true)
     KERNEL_BAZEL_FLAGS += --//build/kernel/kleaf:allow_ddk_unsafe_headers
