 .../org/lineageos/setupwizard/widget/NavigationLayout.kt | 9 +--------
 1 file changed, 1 insertion(+), 8 deletions(-)

diff --git a/app/src/main/java/org/lineageos/setupwizard/widget/NavigationLayout.kt b/app/src/main/java/org/lineageos/setupwizard/widget/NavigationLayout.kt
index 85a1357..b0fadd3 100644
--- a/app/src/main/java/org/lineageos/setupwizard/widget/NavigationLayout.kt
+++ b/app/src/main/java/org/lineageos/setupwizard/widget/NavigationLayout.kt
@@ -35,14 +35,7 @@ class NavigationLayout(context: Context, attrs: AttributeSet) : RelativeLayout(c
         FooterButtonStyleUtils.applyPrimaryButtonPartnerResource(context, nextButton, true)
         FooterButtonStyleUtils.applySecondaryButtonPartnerResource(context, skipButton, true)
 
-        val showSkipButton =
-            context.theme.obtainStyledAttributes(attrs, R.styleable.NavigationLayout, 0, 0).use {
