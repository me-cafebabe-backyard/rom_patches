From dd84862fb1611c2503f150bc6cb33e3103733d2a Mon Sep 17 00:00:00 2001
From: Yumi Yukimura <me.cafebabe@gmail.com>
Date: Tue, 24 Dec 2024 01:11:19 +0800
Subject: [PATCH] build: Include vendor/extra/BoardConfig.mk if available, on
 board_config.mk

Some kind of extras needs to alter variables that becomes read-only
after inclusion of board_config.mk, or wants some variables getting
processed by board_config.mk. For example, native bridge.

Change-Id: If7ef0dcfc30b52940017662fa7402e4970dbc3c7
---
 core/board_config.mk | 1 +
 1 file changed, 1 insertion(+)

diff --git a/core/board_config.mk b/core/board_config.mk
index 6fa9ad940a..f3a05e0f7c 100644
--- a/core/board_config.mk
+++ b/core/board_config.mk
@@ -239,6 +239,7 @@ endif
 
 ifndef RBC_PRODUCT_CONFIG
 include $(board_config_mk)
+-include vendor/extra/BoardConfig.mk
 else
   $(shell mkdir -p $(OUT_DIR)/rbc)
   $(call dump-variables-rbc, $(OUT_DIR)/rbc/make_vars_pre_board_config.mk)
-- 
2.39.5

